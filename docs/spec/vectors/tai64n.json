      "nanoseconds": 16777215,
      "tai64n": "400000000000000b00000000"
    },
    {
      "name": "exact alignment boundary",
      "unix_seconds": 1,
      "nanoseconds": 16777216,
      "tai64n": "400000000000000b01000000"
    },
    {
      "name": "2026-01-01T00:00:00Z plus 999999999 ns",
      "unix_seconds": 1767225600,
      "nanoseconds": 999999999,
      "tai64n": "400000006955b90a3b000000"
    },
    {
      "name": "2026-01-01T00:00:00Z plus 20 ms",
      "unix_seconds": 1767225600,
      "nanoseconds": 20000000,
      "tai64n": "400000006955b90a01000000"
    },
    {
      "name": "largest 32-bit unix time",
      "unix_seconds": 4294967295,
